+    }
+
+    #[tokio::test]
+    async fn event_flush_blocked_video_allows_input_and_preserves_wire_order() {
+        let input = Arc::new(AtomicBool::new(false));
+        let mut server = server(Arc::clone(&input));
+        let state = Mutex::new(&mut server);
+        let started = Arc::new(Notify::new());
+        let release = Arc::new(Notify::new());
+        let output = Rc::new(RefCell::new(Vec::new()));
+        let mut socket = GateWriter {
+            started: Arc::clone(&started),
+            release: Arc::clone(&release),
+            output: Rc::clone(&output),
+            calls: 0,
+            fail_at: None,
+        };
+        let writer = SharedWriter::new(&mut socket);
+        let mut input_writer = writer.clone();
+        let mut subsequent_writer = writer.clone();
+        let pixels = vec![0x55; 128 * 1024];
+        let trailer = vec![0x77; 16];
+        let mut events = vec![
+            graphics(pixels.clone()),
+            graphics(trailer.clone()),
+            ServerEvent::Quit("done".into()),
+        ];
+        let flush = RdpServer::dispatch_event_batch(&state, &mut events, &writer, 1003, 1001, None);
+        tokio::pin!(flush);
+        tokio::select! {
+            _ = started.notified() => {}
+            result = &mut flush => panic!("flush finished before socket gate: {result:?}"),
+        }
+        let blocked_since = Instant::now();
+        let input_since = Instant::now();
+        let input_pdu = encode_vec(&FastPathInput::single(FastPathInputEvent::KeyboardEvent(
+            KeyboardFlags::empty(),
+            0x1e,
+        )))
+        .unwrap();
+        tokio::time::timeout(Duration::from_millis(100), async {
+            let mut server = state.lock().await;
+            server
+                .dispatch_pdu(
+                    Action::FastPath,
+                    input_pdu.as_slice().into(),
+                    &mut input_writer,
+                    1003,
+                    1001,
+                    None,
+                )
+                .await
+                .unwrap();
+        })
+        .await
+        .expect("input blocked behind outbound video socket write");
+        let input_us = input_since.elapsed().as_micros();
+        assert!(input.load(Ordering::Relaxed));
+        assert_eq!(writer.write_counter().load(Ordering::Relaxed), 0);
+        assert!(output.borrow().is_empty());
+        let subsequent = subsequent_writer.write_all(b"later reply");
+        tokio::pin!(subsequent);
+        tokio::select! {
+            _ = tokio::time::sleep(Duration::from_millis(250)) => {}
+            result = &mut subsequent => panic!("later reply overtook reserved batch: {result:?}"),
+            result = &mut flush => panic!("disconnect returned before flushing queued bytes: {result:?}"),
+        }
+        release.notify_one();
+        assert!(matches!(flush.await.unwrap(), RunState::Disconnect));
+        subsequent.await.unwrap();
+        assert_eq!(
+            *output.borrow(),
+            vec![framed(pixels), framed(trailer), b"later reply".to_vec()]
+        );
+        assert_eq!(writer.write_counter().load(Ordering::Relaxed), 3);
+        eprintln!(
+            "deliberate socket stall={}ms; input acquired state and dispatched in {input_us}us",
+            blocked_since.elapsed().as_millis()
+        );
+    }
+
+    #[tokio::test]
+    async fn event_flush_socket_error_propagates_without_counting_failed_or_later_writes() {
+        let mut server = server(Arc::new(AtomicBool::new(false)));
+        let state = Mutex::new(&mut server);
+        let release = Arc::new(Notify::new());
+        release.notify_one();
+        let output = Rc::new(RefCell::new(Vec::new()));
+        let mut socket = GateWriter {
+            started: Arc::new(Notify::new()),
+            release,
+            output: Rc::clone(&output),
+            calls: 0,
+            fail_at: Some(1),
+        };
+        let writer = SharedWriter::new(&mut socket);
+        let mut events = vec![graphics(vec![1]), graphics(vec![2]), graphics(vec![3])];
+        let result = RdpServer::dispatch_event_batch(&state, &mut events, &writer, 1003, 1001, None).await;
+        assert!(result.is_err());
+        assert_eq!(*output.borrow(), vec![framed(vec![1])]);
+        assert_eq!(writer.write_counter().load(Ordering::Relaxed), 1);
+        assert!(state.try_lock().is_ok());
+    }
+
+    struct InvalidPdu;
+    impl ironrdp_core::Encode for InvalidPdu {
+        fn encode(&self, _: &mut ironrdp_core::WriteCursor<'_>) -> ironrdp_core::EncodeResult<()> {
+            Err(ironrdp_core::other_err!("deliberate encoding failure"))
+        }
+        fn name(&self) -> &'static str {
+            "InvalidPdu"
+        }
+        fn size(&self) -> usize {
+            1
+        }
+    }
+    impl ironrdp_svc::SvcEncode for InvalidPdu {}
+
+    #[tokio::test]
+    async fn event_flush_encoding_failure_still_flushes_the_prior_wire_prefix() {
+        let mut server = server(Arc::new(AtomicBool::new(false)));
+        let state = Mutex::new(&mut server);
+        let release = Arc::new(Notify::new());
+        release.notify_one();
+        let output = Rc::new(RefCell::new(Vec::new()));
+        let mut socket = GateWriter {
+            started: Arc::new(Notify::new()),
+            release,
+            output: Rc::clone(&output),
+            calls: 0,
+            fail_at: None,
+        };
+        let writer = SharedWriter::new(&mut socket);
+        let mut events = vec![
+            graphics(vec![1]),
+            ServerEvent::Egfx(EgfxServerMessage::SendMessages {
+                messages: vec![SvcMessage::from(InvalidPdu)],
+            }),
+            graphics(vec![3]),
+        ];
+        assert!(
+            RdpServer::dispatch_event_batch(&state, &mut events, &writer, 1003, 1001, None)
+                .await
+                .is_err()
+        );
+        assert_eq!(*output.borrow(), vec![framed(vec![1])]);
+        assert_eq!(writer.write_counter().load(Ordering::Relaxed), 1);
+    }
+
+    #[tokio::test]
+    async fn event_flush_staging_limit_rejects_before_allocating_over_limit() {
+        let mut staged = StagedWriter {
+            bytes: StagedWriter::MAX_BYTES - 2,
+            chunks: Vec::new(),
+        };
+        staged.write_all(&[1, 2]).await.unwrap();
+        assert!(staged.write_all(&[3]).await.is_err());
+        assert_eq!(staged.bytes, StagedWriter::MAX_BYTES);
+        assert_eq!(staged.chunks, vec![vec![1, 2]]);
+    }
+}
